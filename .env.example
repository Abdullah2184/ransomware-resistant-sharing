# Runtime environment mode (`development` or `production`).
# In `production`, services refuse placeholder secrets, unsafe dev relayer/custody
# flags, and non-HTTPS non-loopback infrastructure endpoints (§13).
RRDS_ENV=development

# Local PostgreSQL configuration (replace all placeholders with random secrets)
POSTGRES_DB=rrfs_dev
POSTGRES_USER=rrfs_app
POSTGRES_PASSWORD=replace-with-a-generated-local-password
RRFS_MIGRATOR_PASSWORD=replace-with-a-generated-local-secret
RRFS_GATEWAY_PASSWORD=replace-with-a-generated-local-secret
RRFS_INDEXER_PASSWORD=replace-with-a-generated-local-secret

# Database connection & SQLx migration mode (§7.14, §13)
# Use `rrfs_migrator` with `rrds-migrate run` / `DATABASE_MIGRATION_MODE=run`,
# and least-privilege `rrfs_gateway` / `rrfs_indexer` with `DATABASE_MIGRATION_MODE=verify`.
DATABASE_URL=postgres://rrfs_migrator:replace-with-migrator-password@127.0.0.1:5432/rrfs_dev
DATABASE_MIGRATION_MODE=verify
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# Permissioned Hyperledger Besu QBFT network (§7.14; no public-chain endpoints)
BESU_RPC_URL=http://127.0.0.1:8545
BESU_CHAIN_ID=1337
# Deployed RRDS contract addresses (fill from deployment snapshot)
# CONTRACT_TIMELOCK_ADDRESS=0x...
# CONTRACT_ACCESS_GOVERNANCE_ADDRESS=0x...
# CONTRACT_FILE_REGISTRY_ADDRESS=0x...

# Relayer & blockchain transaction policy (§7.14)
# Store production relayer keys in HSM/KMS custody; never commit private keys.
RELAYER_KEY_PROVIDER=development-env-unsafe-only
APPLICATION_NONCE_POLICY=eip712-per-operation-random-32b
DEFAULT_TX_GAS_LIMIT=2000000
TRANSACTION_CONFIRMATION_TIMEOUT=30
# Local development ONLY (rejected when RRDS_ENV=production):
# GATEWAY_ALLOW_UNSAFE_DEV_RELAYER=true
# GATEWAY_RELAYER_UNSAFE_DEV_KEY=0x...

# Indexer configuration (§7.14)
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=100
FINALITY_CHECK_INTERVAL=5
INDEXER_CONFIRMATION_POLICY=finalized
INDEXER_RECONCILIATION_INTERVAL_SECONDS=60

# Gateway HTTP API, rate limits, concurrency & maintenance (§8, §9.9 B, §13)
GATEWAY_AUDIENCE=rrds-local
GATEWAY_BIND=127.0.0.1:8080
GATEWAY_CHALLENGE_TTL_SECONDS=120
GATEWAY_SESSION_TTL_SECONDS=900
GATEWAY_RATE_LIMIT_CAPACITY=30
GATEWAY_RATE_LIMIT_REFILL_PER_SECOND=0.5
GATEWAY_MEMBER_RATE_LIMIT_CAPACITY=60
GATEWAY_MEMBER_RATE_LIMIT_REFILL_PER_SECOND=1.0
GATEWAY_ORG_RATE_LIMIT_CAPACITY=300
GATEWAY_ORG_RATE_LIMIT_REFILL_PER_SECOND=5.0
GATEWAY_INVALID_SIG_LIMIT_CAPACITY=10
GATEWAY_INVALID_SIG_LIMIT_REFILL_PER_SECOND=0.1
GATEWAY_MAX_CONCURRENT_STREAMS=32
GATEWAY_MAX_BLOB_UPLOAD_BYTES=67108864
ORPHAN_RETENTION_SECONDS=3600
GATEWAY_STORAGE_HEALTH_INTERVAL_SECONDS=30

# Private Kubo & IPFS Cluster endpoints (§10.4.3, §13; loopback-only in local dev)
IPFS_API_URLS=http://127.0.0.1:15001,http://127.0.0.1:15002
IPFS_CLUSTER_API_URL=http://127.0.0.1:9094
IPFS_CLUSTER_ADMIN_URL=http://127.0.0.1:9094
IPFS_CLUSTER_USERNAME=rrfs-admin
IPFS_CLUSTER_PASSWORD_FILE=infra/ipfs-cluster/secrets/cluster-api-password
MIN_PIN_REPLICAS=2
