# Local PostgreSQL configuration
POSTGRES_DB=rrfs_dev
POSTGRES_USER=rrfs_app
POSTGRES_PASSWORD=replace-with-a-generated-local-password
RRFS_MIGRATOR_PASSWORD=replace-with-a-generated-local-secret
RRFS_GATEWAY_PASSWORD=replace-with-a-generated-local-secret
RRFS_INDEXER_PASSWORD=replace-with-a-generated-local-secret

# SQLx migration connection (local development)
# Local permissioned Besu development network (no public-chain endpoints)
BESU_RPC_URL=http://127.0.0.1:8545
BESU_CHAIN_ID=1337
# Store the deployment key in the Hardhat keystore; do not put a private key here.

# Indexer (fill contract addresses from the local Besu deployment)
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=100
INDEXER_CONFIRMATION_POLICY=finalized
INDEXER_RECONCILIATION_INTERVAL_SECONDS=60
# CONTRACT_FILE_REGISTRY_ADDRESS=0x...
# CONTRACT_ACCESS_GOVERNANCE_ADDRESS=0x...

# Gateway (local authentication foundation; not a production deployment)
GATEWAY_AUDIENCE=rrds-local
GATEWAY_BIND=127.0.0.1:8080
# Set both contract addresses from the deployed local Besu contracts.
# CONTRACT_ACCESS_GOVERNANCE_ADDRESS=0x...
# CONTRACT_FILE_REGISTRY_ADDRESS=0x...
GATEWAY_CHALLENGE_TTL_SECONDS=120
GATEWAY_SESSION_TTL_SECONDS=900
GATEWAY_RATE_LIMIT_CAPACITY=30
GATEWAY_RATE_LIMIT_REFILL_PER_SECOND=0.5

# Local IPFS Cluster API (Cluster credentials are generated into ignored local files)
IPFS_API_URL=http://kubo:5001
IPFS_CLUSTER_API_URL=http://cluster1:9094
IPFS_CLUSTER_ADMIN_URL=http://127.0.0.1:9094
IPFS_CLUSTER_USERNAME=rrfs-admin
IPFS_CLUSTER_PASSWORD_FILE=infra/ipfs-cluster/secrets/cluster-api-password
MIN_PIN_REPLICAS=2
DATABASE_URL=postgres://rrfs_migrator:replace-with-migrator-password@127.0.0.1:5432/rrfs_dev
