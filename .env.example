# Local PostgreSQL configuration
POSTGRES_DB=rrfs_dev
POSTGRES_USER=rrfs_app
POSTGRES_PASSWORD=replace-with-a-generated-local-password
RRFS_MIGRATOR_PASSWORD=replace-with-a-generated-local-secret
RRFS_GATEWAY_PASSWORD=replace-with-a-generated-local-secret
RRFS_INDEXER_PASSWORD=replace-with-a-generated-local-secret

# SQLx migration connection (local development)
DATABASE_URL=postgres://rrfs_migrator:replace-with-migrator-password@127.0.0.1:5432/rrfs_dev
